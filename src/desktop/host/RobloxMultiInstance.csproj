<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>RobloxMultiInstance</AssemblyName>
    <StartupObject>RobloxMultiInstance.Desktop.Entry</StartupObject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WPF owns startup; Forms is used only for tray interop. DPI must be selected before WPF creates any HWND. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <ProjectReference Include="../presentation/RobloxMultiInstance.Presentation.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <ProjectReference Include="../backend/RobloxMultiInstance.Backend.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SupportConfigPath)' != ''">
    <Content Include="$(SupportConfigPath)" Link="support-config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
