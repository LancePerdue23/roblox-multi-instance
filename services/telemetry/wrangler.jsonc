{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rmi-optional-errors",
  "main": "src/index.js",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "vars": { "INGESTION_ENABLED": "false" },
  "ratelimits": [{ "name": "INGEST_RATE", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "d1_databases": [{ "binding": "DB", "database_name": "rmi-optional-errors", "database_id": "REPLACE_WITH_FREE_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["17 3 * * *"] }
}
