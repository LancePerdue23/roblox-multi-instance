param([string]$Baseline = (Join-Path $PSScriptRoot '..\..\.build\migration-baseline\20261030-211138'))
$ErrorActionPreference = 'Stop'
$taskRoot = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..\..'))
$taskHashes = Get-Content -LiteralPath (Join-Path $Baseline 'source-hashes.json') -Raw | ConvertFrom-Json
foreach ($entry in $taskHashes) {
    $taskPath = Join-Path $taskRoot $entry.Path
    if (!(Test-Path -LiteralPath $taskPath -PathType Leaf) -or (Get-FileHash -LiteralPath $taskPath -Algorithm SHA256).Hash -ne $entry.SHA256) { throw "Baseline changed: $($entry.Path)" }
}
$taskRelease = Join-Path $taskRoot 'release\RobloxLaunchHelper.exe'
$taskReleaseHash = Get-Content -LiteralPath (Join-Path $Baseline 'release-hash.json') -Raw | ConvertFrom-Json
if ((Get-FileHash -LiteralPath $taskRelease -Algorithm SHA256).Hash -ne $taskReleaseHash.Hash) { throw 'Original release executable changed.' }
Write-Output "PASS: $($taskHashes.Count) original project files and release executable match the preserved baseline."
